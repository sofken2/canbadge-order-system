{
  "name": "canbadge-order-system",
  "private": true,
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --env-file=.env.example --env-file=.env run turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "biome format --write .",
    "db:reset": "bun --env-file=.env.example --env-file=.env run turbo run db:reset",
    "db:reset:force": "bun --env-file=.env.example --env-file=.env run turbo run db:reset:force",
    "backup": "bun --env-file=.env.example --env-file=.env packages/db/src/backup-cli.ts",
    "restore": "bun --env-file=.env.example --env-file=.env packages/db/src/restore-cli.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/bun": "latest",
    "turbo": "^2.0.0",
    "typescript": "^5.6.0"
  }
}
