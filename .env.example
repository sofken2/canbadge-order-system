# 開発用のポート。Caddy（infra/）もこの値を向ける
WEB_PORT=3000
STAFF_PORT=3001
API_PORT=3002

# SQLite・画像・生成PDF の置き場所（コミット対象外）
DATA_DIR=./data

# api が操作ログを読んで SSE のイベントを流す間隔（ミリ秒）
SSE_POLL_MS=2000
# SSE の接続を保つ、空のコメント行（ハートビート）を送る間隔（ミリ秒）。既定 20000。Cloudflare は 100 秒データがない接続を切るので、これより長くしない
# SSE_HEARTBEAT_MS=20000

# print-worker：印刷ドライバーと、キューの巡回の間隔（ミリ秒）
# PRINT_DRIVER=dev（既定）：PDF を data/print-out/ に出すだけ（用紙は出ない）
# PRINT_DRIVER=sumatra：本番。SumatraPDF で、PRINTER_NAME のプリンターへ、拡大縮小なしで送る（Windows だけ）
PRINT_DRIVER=dev
# 本番（sumatra）のとき：Windows のプリンター名。名前は、`bun run printers`（apps/print-worker）で、一覧が見られる
# PRINTER_NAME=Canon TS6730 series
# SumatraPDF.exe の場所。省略すると、%LOCALAPPDATA%\SumatraPDF・Program Files を探す
# SUMATRA_PATH=
PRINT_POLL_MS=2000
# 印刷待ちの最大時間（秒）を、設定画面の値の代わりに上書きする。開発用で、普段は付けない
# PRINT_WAIT_OVERRIDE_SECONDS=5

# 1 にすると、Cloudflare 経由・LAN など、すべての経路から、認証なしで、スタッフ用の API を使える。
# **開発で試すときだけ。本番の .env には、書かない**（api の起動時に警告が出る）
# ALLOW_UNAUTHENTICATED_STAFF=1

# バックアップ（infra/backup.md）。BACKUP_DIR は、処理PC とは別の物理ドライブ（外付けなど）のフォルダ。
# 設定すると、bun run backup と、定期実行（register-backup-task.ps1）が使える。BACKUP_KEEP は残す数（既定 288）
# BACKUP_DIR=E:\canbadge-backup
# BACKUP_KEEP=288

# Caddy（処理PC の入口）。start-all.ps1 が、ここから値を取って Caddy に渡す。
# STAFF_HOST は、スタッフ用のホスト名（本番）。省略すると staff.localhost
# STAFF_HOST=badge-staff.sofken2-ts.app
# CADDY_PORT=8080

# Cloudflare（infra/cloudflare.md）。値は処理PC の .env にだけ書く
# Access：api が、スタッフ用 API に付く Cf-Access-Jwt-Assertion の署名を検証するのに使う（A05）。
# 未設定だと、Cloudflare 経由のスタッフ用の API は、すべて断る
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
# Turnstile：サイトキーは公開してよい（W02）。シークレットキーは秘密（A06）
TURNSTILE_SITE_KEY=
# 未設定だと、api は、Turnstile を検証しない（開発用。起動時に警告が出る）。**本番では必ず設定する**
# テスト用（Cloudflare 公式）：1x0000000000000000000000000000000AA（常に成功）／2x0000000000000000000000000000000AA（常に失敗）
TURNSTILE_SECRET_KEY=

# 来場者向けサイトの URL。スタッフの呼び出しモニターに出る固定 QR になる（ビルド時に決まる）。
# 本番は公開の URL（https://...）。開発は http://localhost:3000
# VITE_SITE_URL=http://localhost:3000

# Anubis（ボット対策の入口。infra/anubis/・infra/README.md）。1 にすると、来場者用の画面（HTML）の前に置く。
# 先に infra/windows/install-anubis.ps1 で入れておく。既定は使わない（0）
# ANUBIS_ENABLED=1
# 確認の難しさ（先頭に必要な 0 の数）。大きいほど、スマホで時間がかかる。既定 4（1 秒未満）
# ANUBIS_DIFFICULTY=4
# 署名鍵（64 桁の 16 進数）。決めないと、再起動のたびに、来場者の確認がやり直しになる。
# 作り方（PowerShell）: [Convert]::ToHexString([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(32)).ToLower()
# ANUBIS_ED25519_PRIVATE_KEY_HEX=
# ANUBIS_PORT=8923
# WEB_ORIGIN_PORT=8081
