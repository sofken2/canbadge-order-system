# 開発用のポート。Caddy（infra/）もこの値を向ける
WEB_PORT=3000
STAFF_PORT=3001
API_PORT=3002

# SQLite・画像・生成PDF の置き場所（コミット対象外）
DATA_DIR=./data

# api が操作ログを読んで SSE のイベントを流す間隔（ミリ秒）
SSE_POLL_MS=2000

# print-worker：印刷ドライバー（dev は PDF を data/print-out/ に出すだけ。本番用は P03）と、キューの巡回の間隔（ミリ秒）
PRINT_DRIVER=dev
PRINT_POLL_MS=2000
# 印刷待ちの最大時間（秒）を、設定画面の値の代わりに上書きする。開発用で、普段は付けない
# PRINT_WAIT_OVERRIDE_SECONDS=5

# 1 にすると、Cloudflare 経由（公開経路）のリクエストにも、スタッフ用の API を許す。
# スタッフ認証（A05）ができるまでは、開発で試すとき以外は使わない
# ALLOW_UNAUTHENTICATED_STAFF=1
