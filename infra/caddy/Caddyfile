# 処理PC の唯一の入口（spec.md 3.2）。
# いまは app がまだないので、ダミーページを直接返す。
# T01 で各 app のポートが決まったら、file_server と respond を reverse_proxy に差し替える。
#
# 環境変数（未設定なら右の既定値）:
#   CADDY_PORT  待ち受けポート              8080
#   STAFF_HOST  スタッフ用のホスト名        staff.localhost

{
	# TLS は Cloudflare 側で終端する。Caddy は HTTP だけを受ける
	auto_https off
	admin off
}

# /api/* の仮の応答。T07 以降は apps/api へ転送する:
#   reverse_proxy localhost:<apiのポート> {
#       flush_interval -1   # SSE をため込まずに流す（I02 の確認事項）
#   }
(api_dummy) {
	handle /api/* {
		header Content-Type "application/json; charset=utf-8"
		respond `{"status":"dummy","message":"api はまだありません"}` 200
	}
}

# スタッフ用（本番: staff.<ドメイン>）
http://{$STAFF_HOST:staff.localhost}:{$CADDY_PORT:8080} {
	import api_dummy
	handle {
		root * dummy/staff
		file_server
	}
}

# 来場者用（本番: badge.<ドメイン>）。上に一致しないホスト名はすべてここに来る。
# 仮 URL（trycloudflare.com）はホスト名が毎回変わるため、ホスト名を固定しない
:{$CADDY_PORT:8080} {
	import api_dummy
	handle {
		root * dummy/web
		file_server
	}
}
